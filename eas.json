{
  "cli": {
    "version": ">= 18.12.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "channel": "development",
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "presentation": {
      "channel": "presentation",
      "distribution": "internal",
      "env": {
        "APP_ENV": "presentation"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "extends": "presentation",
      "channel": "presentation"
    },
    "github": {
      "extends": "presentation",
      "channel": "presentation",
      "ios": {
        "simulator": false
      }
    },
    "ios-simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "update": {
    "development": {
      "channel": "development"
    },
    "presentation": {
      "channel": "presentation"
    },
    "preview": {
      "channel": "presentation"
    },
    "production": {
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
