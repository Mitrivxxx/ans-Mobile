{
  "name": "wdmobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "generate-icons": "echo Generating icons (skipped)",
    "preandroid": "adb reverse tcp:8081 tcp:8081",
    "android": "expo run:android",
    "prebuild:android": "npm run generate-icons && expo prebuild --platform android",
    "prebuild:android:clean": "npm run generate-icons && expo prebuild --platform android --clean",
    "prebuild:prod": "cross-env APP_ENV=production EAS_BUILD_PROFILE=production npm run prebuild:android",
    "build:apk:local": "npm run prebuild:prod && cd android && cross-env APP_ENV=production EAS_BUILD_PROFILE=production gradlew.bat assembleRelease",
    "install:apk:local": "adb install -r android\\app\\build\\outputs\\apk\\release\\app-release.apk",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios --profile ios-simulator --non-interactive",
    "build:development": "eas build --profile development",
    "build:demo": "eas build --profile demo",
    "build:github": "eas build --profile github --platform android",
    "build:production": "eas build --profile production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/stack": "^7.8.13",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-persist-client": "^5.100.11",
    "axios": "^1.16.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "linkedom": "^0.18.12",
    "qs": "^6.15.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/qs": "^6.15.1",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "private": true
}
