{
  "name": "wdmobile",
  "version": "0.1.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --clean",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate-icons": "node scripts/generateAppIcons.mjs",
    "build:ios": "eas build --platform ios --profile ios-simulator --non-interactive",
    "build:github": "eas build --platform all --profile github --non-interactive",
    "build:github:android": "eas build --platform android --profile github --non-interactive",
    "build:github:ios": "eas build --platform ios --profile github --non-interactive"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/stack": "^7.8.13",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-persist-client": "^5.100.11",
    "axios": "^1.16.0",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^55.0.17",
    "linkedom": "^0.18.12",
    "qs": "^6.15.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "@types/qs": "^6.15.1",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "typescript": "~5.9.2"
  },
  "private": true
}
